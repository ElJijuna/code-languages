  "scripts": {
    "bench": "vitest bench --run",
    "build": "tsup",
    "check": "biome check . && tsc --noEmit && vitest run",
    "check:language-versions": "node scripts/check-language-versions.mjs",
    "format": "biome format --write .",
    "lint": "biome check .",
    "prepare": "husky",
    "release": "semantic-release",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "website:bench": "node scripts/run-website-benchmarks.mjs",
    "website:data": "node scripts/generate-website-data.mjs",
    "website:prepare": "node scripts/ensure-website-data-dir.mjs && npm run build && npm run website:test && npm run website:bench && npm run website:data && biome format --write docs/data/*.json",
    "website:serve": "node scripts/serve-website.mjs",
    "website:test": "node scripts/ensure-website-data-dir.mjs && vitest run --reporter=json --outputFile=docs/data/unit-results.json && node scripts/summarize-website-tests.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.3.5",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "husky": "^9.1.7",
    "semantic-release": "^24.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
